---
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { SITE } from '@/consts'
import { requireIntro, requireSection, splitItems } from '@/lib/markdown-sections'
import { getCollection } from 'astro:content'

const page = (await getCollection('pages')).find((entry) => entry.data.slug === '/about')

if (!page) {
  throw new Error('Missing pages/about.md content entry')
}

const rawBody = (page.body ?? '').replace(/\r\n/g, '\n')
const intro = requireIntro(rawBody, 'About', 'pages/about.md')
const introParagraphs = intro
  .split(/\n\s*\n/)
  .map((part) => part.trim().replace(/\n+/g, ' '))
  .filter(Boolean)

const experienceItems = splitItems(requireSection(rawBody, 'Experience', 'pages/about.md'))
  .map((part) => {
    const lines = part
      .split('\n')
      .map((line) => line.trim())
      .filter(Boolean)
    if (lines.length === 0) return null
    const titleLine = lines[0] || ''
    const [role, company] = titleLine.includes('·')
      ? titleLine.split('·').map((part) => part.trim())
      : [titleLine.trim(), '']
    if (!role) return null
    return {
      role,
      company,
      date: lines[1] || '',
      description: lines.slice(2).join(' ').trim(),
    }
  })
  .filter((item): item is { role: string; company: string; date: string; description: string } => Boolean(item))

const educationItems = splitItems(requireSection(rawBody, 'Education', 'pages/about.md'))
  .map((part) => {
    const lines = part
      .split('\n')
      .map((line) => line.trim())
      .filter(Boolean)
    if (lines.length === 0) return null
    const titleLine = (lines[0] || '').replace(/^###\s*/, '').trim()
    const [degree, institution] = titleLine.includes('·')
      ? titleLine.split('·').map((part) => part.trim())
      : [titleLine.trim(), '']
    const gpaMatch = (lines[2] || '').match(/GPA\s+([\d.]+)/)
    if (!degree) return null
    return {
      degree,
      institution,
      date: lines[1] || '',
      gpa: gpaMatch ? gpaMatch[1] : null,
      details: lines.slice(gpaMatch ? 3 : 2).join('\n').trim(),
    }
  })
  .filter(
    (item): item is { degree: string; institution: string; date: string; gpa: string | null; details: string } =>
      Boolean(item),
  )

const skillsItems = splitItems(requireSection(rawBody, 'Skills', 'pages/about.md'))
  .map((part) => {
    const lines = part
      .split('\n')
      .map((line) => line.trim())
      .filter(Boolean)
    if (lines.length === 0) return null
    const title = (lines[0] || '').replace(/^###\s*/, '').trim()
    const rest = lines.slice(1).join('\n').trim()
    const tags = rest.match(/`([^`]+)`/g)?.map((tag) => tag.replace(/`/g, '')) ?? []
    const description = rest.replace(/(`[^`]+`\s*)+/g, '').trim()
    if (!title) return null
    return { title, description, tags }
  })
  .filter((item): item is { title: string; description: string; tags: string[] } => Boolean(item))
---

<Layout>
  <PageHead slot="head" title={page.data.title} description={page.data.description} imagePath={page.data.ogImage} />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: SITE.author,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Berlin',
        addressCountry: 'DE',
      },
      url: SITE.href,
      email: SITE.email,
      sameAs: ['https://github.com/spignotti', 'https://www.linkedin.com/in/silas-pignotti/'],
    })}
  />

  <header class="section measure">
    <h1 class="h1">{page.data.title}</h1>
    {
      introParagraphs.map((paragraph) => (
        <p class="hero-copy">{paragraph}</p>
      ))
    }
  </header>

  {
    experienceItems.length > 0 && (
      <section class="section" aria-labelledby="experience-heading">
        <h2 id="experience-heading" class="h2">Experience</h2>
        <div class="stack">
          {experienceItems.map((item) => (
            <article class="entry">
              <div class="entry-head">
                <h3 class="h3">{item.role}</h3>
                {item.date && <p class="meta">{item.date}</p>}
              </div>
              {item.company && <p class="sub">{item.company}</p>}
              {item.description && <p class="hero-copy">{item.description}</p>}
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    educationItems.length > 0 && (
      <section class="section" aria-labelledby="education-heading">
        <h2 id="education-heading" class="h2">Education</h2>
        <div class="stack">
          {educationItems.map((item) => (
            <article class="entry">
              <div class="entry-head">
                <h3 class="h3">{item.degree}</h3>
                <div class="entry-meta">
                  {item.date && <p class="meta">{item.date}</p>}
                  {item.gpa && (
                    <p class="meta">
                      GPA <span class="meta-strong">{item.gpa}</span>
                    </p>
                  )}
                </div>
              </div>
              {item.institution && <p class="sub">{item.institution}</p>}
              {item.details &&
                item.details
                  .split('\n')
                  .map((line) => line.trim())
                  .filter(Boolean)
                  .map((line) => <p class="hero-copy">{line.replace(/^[-•]\s*/, '')}</p>)}
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    skillsItems.length > 0 && (
      <section class="section" aria-labelledby="skills-heading">
        <h2 id="skills-heading" class="h2">Skills</h2>
        <div class="stack">
          {skillsItems.map((skill) => (
            <article class="entry">
              <div>
                <h3 class="h3">{skill.title}</h3>
                {skill.description && <p class="hero-copy">{skill.description}</p>}
                {skill.tags.length > 0 && (
                  <ul class="badge-row block">
                    {skill.tags.map((tag) => (
                      <li class="badge">{tag}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }
</Layout>
