---
import Layout from '@/layouts/Layout.astro'
import { UI, pagePath } from '@/i18n'

const ui = UI.de
---

<Layout lang="de" path="/404" title={ui.notFoundSeo} description={ui.notFoundText} current={null}>
  <div class="wrap miss">
    <h1>{ui.notFoundTitle}</h1>
    <p>{ui.notFoundText}</p>
    <div class="miss-actions">
      <a class="btn" href={pagePath('de', 'home')}>{ui.notFoundHome}</a>
      <a class="btn btn-outline" href={pagePath('de', 'projects')}>{ui.viewProjects}</a>
    </div>
  </div>
</Layout>
