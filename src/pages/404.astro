---
import Layout from '@/layouts/Layout.astro'
import { withBasePath } from '@/lib/paths'
---

<Layout lang="de" title="Seite nicht gefunden" description="Diese Seite gibt es nicht." contact={false}>
  <section class="measure">
    <h1 class="h1">Seite nicht gefunden</h1>
    <p class="lead">Diese Seite gibt es nicht. <span lang="en">This page does not exist.</span></p>
    <p class="sub">
      <a class="text-link" href={withBasePath('/')}>Start</a> ·
      <a class="text-link" href={withBasePath('/en')} lang="en">Home</a>
    </p>
  </section>
</Layout>
