---
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { SITE } from '@/consts'
import { getAllProjects } from '@/lib/data-utils'
import { withBasePath } from '@/lib/paths'
import { requireIntro, requireSection, splitItems } from '@/lib/markdown-sections'
import { getCollection } from 'astro:content'

const page = (await getCollection('pages')).find((entry) => entry.data.slug === '/')
const projects = await getAllProjects()
const featuredOrder = ['routing-engine', 'master-thesis-uhi', 'litresearch']

if (!page) {
  throw new Error('Missing pages/landing.md content entry')
}

const normalizedBody = (page.body ?? '').replace(/\r\n/g, '\n')
// The markdown heading is a section key only. It is not rendered.
const hero = requireIntro(normalizedBody, 'Portfolio', 'pages/landing.md')
const heroParts = hero
  .split(/\n\s*\n/)
  .map((part) => part.trim().replace(/\n+/g, ' '))
  .filter(Boolean)
const tagline = heroParts[0] ?? ''
const heroParagraphs = heroParts.slice(1)

const focusSection = requireSection(normalizedBody, 'Focus Areas', 'pages/landing.md')
const focusItems = splitItems(focusSection)
  .map((part) => {
    const [title, ...rest] = part.split('\n')
    return {
      title: title?.trim() ?? '',
      description: rest.join('\n').trim().replace(/\n+/g, ' '),
    }
  })
  .filter((item) => item.title && item.description)

const withShots = projects.filter((project) => (project.data.screenshots?.length ?? 0) > 0)
const shotSlugs = new Set(withShots.map((project) => project.data.slug))
const featuredProjects = projects
  .filter((project) => project.data.featured && !shotSlugs.has(project.data.slug))
  .sort((a, b) => {
    const aRank = featuredOrder.indexOf(a.data.slug)
    const bRank = featuredOrder.indexOf(b.data.slug)
    if (aRank !== -1 || bRank !== -1) {
      return (aRank === -1 ? Number.MAX_SAFE_INTEGER : aRank) - (bRank === -1 ? Number.MAX_SAFE_INTEGER : bRank)
    }
    return (b.data.year ?? 0) - (a.data.year ?? 0)
  })
  .slice(0, 3)
---

<Layout>
  <PageHead slot="head" title={page.data.title} description={page.data.description} imagePath={page.data.ogImage} />

  <section class="section" aria-labelledby="home-heading">
    <p class="label">{SITE.location}</p>
    <h1 id="home-heading" class="display">{SITE.author}</h1>
    {tagline && <p class="lead">{tagline}</p>}
    {
      heroParagraphs.length > 0 && (
        <div class="hero-copy">
          {heroParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )
    }
    <div class="hero-actions">
      <a class="button button-accent" href={`mailto:${SITE.email}`}>Email</a>
    </div>
  </section>

  <section class="section" aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="h2">Projects</h2>
    {
      withShots.length > 0 && (
        <div class="shot-row">
          {withShots.map((project) => {
            const shot = project.data.screenshots?.[0]
            if (!shot) return null
            return (
              <a class="shot" href={withBasePath(`/projects/${project.data.slug}`)}>
                <img src={withBasePath(shot.src)} alt={shot.alt} loading="lazy" decoding="async" />
                <span class="shot-caption">
                  <span class="shot-title">{project.data.title}</span>
                  <span class="meta">{project.data.completed ? project.data.year : 'Ongoing'}</span>
                </span>
              </a>
            )
          })}
        </div>
      )
    }
    {
      featuredProjects.length > 0 && (
        <div class="work-list">
          {featuredProjects.map((project) => (
            <a class="work-row" href={withBasePath(`/projects/${project.data.slug}`)}>
              <span class="meta meta-strong">{project.data.completed ? project.data.year : 'Ongoing'}</span>
              <span>
                <span class="work-title">{project.data.title}</span>
                {project.data.tagline && <p class="work-tagline">{project.data.tagline}</p>}
              </span>
            </a>
          ))}
        </div>
      )
    }
    <a class="text-link section-link" href={withBasePath('/projects')}>All projects</a>
  </section>

  {
    focusItems.length > 0 && (
      <section class="section" aria-labelledby="focus-heading">
        <h2 id="focus-heading" class="h2">Focus Areas</h2>
        <div class="card card-pad block">
          <div class="split">
            {focusItems.map((item) => (
              <div>
                <h3 class="h3">{item.title}</h3>
                <p class="sub">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>
