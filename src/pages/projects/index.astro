---
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects } from '@/lib/data-utils'
import { requireSection } from '@/lib/markdown-sections'
import { withBasePath } from '@/lib/paths'
import { PROJECT_CATEGORIES } from '@/lib/project-categories'
import { getCollection } from 'astro:content'

const page = (await getCollection('pages')).find((entry) => entry.data.slug === '/projects')

if (!page) {
  throw new Error('Missing pages/projects.md content entry')
}

const projects = await getAllProjects()
const introParagraphs = requireSection((page.body ?? '').replace(/\r\n/g, '\n'), 'Projects', 'pages/projects.md')
  .split(/\n\s*\n/)
  .map((part) => part.trim().replace(/\n+/g, ' '))
  .filter(Boolean)
const filters = ['All', ...PROJECT_CATEGORIES]
---

<Layout>
  <PageHead slot="head" title={page.data.title} description={page.data.description} imagePath={page.data.ogImage} />

  <header class="measure">
    <h1 class="h1">{page.data.title}</h1>
    {introParagraphs.map((paragraph) => <p class="hero-copy">{paragraph}</p>)}
  </header>

  <div class="filters" role="toolbar" aria-label="Filter projects">
    {
      filters.map((filter, index) => (
        <button type="button" class="filter" data-filter={filter} aria-pressed={index === 0 ? 'true' : 'false'}>
          {filter}
        </button>
      ))
    }
  </div>

  <div class="work-list" id="project-list">
    {
      projects.map((project) => (
        <a class="work-row" href={withBasePath(`/projects/${project.data.slug}`)} data-category={project.data.category}>
          <span class="meta meta-strong">{project.data.completed ? project.data.year : 'Ongoing'}</span>
          <span>
            <span class="work-title">{project.data.title}</span>
            {project.data.tagline && <p class="work-tagline">{project.data.tagline}</p>}
          </span>
        </a>
      ))
    }
  </div>
  <p id="project-empty" class="empty" hidden>No projects in this category.</p>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]')
  const items = document.querySelectorAll<HTMLElement>('#project-list [data-category]')
  const empty = document.getElementById('project-empty')

  function apply(name: string) {
    let shown = 0
    items.forEach((item) => {
      const match = name === 'All' || item.dataset.category === name
      item.hidden = !match
      if (match) shown += 1
    })
    if (empty) empty.hidden = shown !== 0
    buttons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.filter === name))
    })
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      if (button.dataset.filter) apply(button.dataset.filter)
    })
  })
</script>
