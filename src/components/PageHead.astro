---
import { SITE } from '@/consts'

interface Props {
  title?: string
  description?: string
  imagePath?: string
}

const { title = SITE.title, description = SITE.description, imagePath = '/ogImage.svg' } = Astro.props
const image = new URL(imagePath, Astro.site).toString()
const descTrimmed = description.trim()
const optimizedDescription = descTrimmed.length > 155 ? `${descTrimmed.slice(0, 152)}...` : descTrimmed
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const rawTitle = path === '/' || title === SITE.title ? SITE.title : `${title} | ${SITE.title}`
const pageTitle = rawTitle.length > 60 ? `${rawTitle.slice(0, 57)}...` : rawTitle
---

<title>{pageTitle}</title>
<meta name="description" content={optimizedDescription} />
<link rel="canonical" href={Astro.url} />

<meta property="og:title" content={title} />
<meta property="og:description" content={optimizedDescription} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={title} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:type" content="website" />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:url" content={Astro.url} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={optimizedDescription} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={title} />

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.href}#website`,
    url: SITE.href,
    name: SITE.title,
    description: SITE.description,
    inLanguage: SITE.locale,
    publisher: {
      '@type': 'Person',
      name: SITE.author,
      url: SITE.href,
    },
  })}
/>
