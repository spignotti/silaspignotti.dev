---
import { SITE } from '@/consts'
import type { Lang } from '@/i18n'
import { HTML_LANG, OG_LOCALE, otherLang, pagePath } from '@/i18n'

interface Props {
  lang: Lang
  title: string
  description: string
  alternate?: string
  imagePath?: string
}

const { lang, title, description, alternate, imagePath = '/og/default.png' } = Astro.props
const image = new URL(imagePath, Astro.site).toString()
const descTrimmed = description.trim()
const optimizedDescription = descTrimmed.length > 155 ? `${descTrimmed.slice(0, 152)}...` : descTrimmed
const isHome = Astro.url.pathname.replace(/\/$/, '') === pagePath(lang, 'home').replace(/\/$/, '')
const rawTitle = isHome || title === SITE.title ? SITE.title : `${title} – ${SITE.title}`
const pageTitle = rawTitle.length > 60 ? `${rawTitle.slice(0, 57)}...` : rawTitle
const canonical = new URL(Astro.url.pathname, Astro.site).toString()
const other = otherLang(lang)
const alternateUrl = alternate
  ? new URL(alternate.endsWith('/') ? alternate : `${alternate}/`, Astro.site).toString()
  : undefined
const deUrl = lang === 'de' ? canonical : alternateUrl
---

<title>{pageTitle}</title>
<meta name="description" content={optimizedDescription} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang={HTML_LANG[lang]} href={canonical} />
{alternateUrl && <link rel="alternate" hreflang={HTML_LANG[other]} href={alternateUrl} />}
{deUrl && <link rel="alternate" hreflang="x-default" href={deUrl} />}

<meta property="og:title" content={title} />
<meta property="og:description" content={optimizedDescription} />
<meta property="og:image" content={image} />
<meta property="og:image:alt" content={title} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:type" content="website" />
<meta property="og:locale" content={OG_LOCALE[lang]} />
{alternateUrl && <meta property="og:locale:alternate" content={OG_LOCALE[other]} />}
<meta property="og:site_name" content={SITE.title} />
<meta property="og:url" content={canonical} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={optimizedDescription} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={title} />

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.href}#website`,
    url: SITE.href,
    name: SITE.title,
    inLanguage: ['de-DE', 'en-US'],
    publisher: { '@id': `${SITE.href}#person` },
  })}
/>
