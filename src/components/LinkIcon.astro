---
/** Small mark in front of a project link: the site's logo where known, else nothing. Inline, no third-party fetch. */
interface Props {
  href: string
}

const href = Astro.props.href.toLowerCase()
const kind = href.includes('tourengenie.de') ? 'tourengenie' : href.includes('github.com') ? 'github' : /\.pdf$/.test(href) ? 'pdf' : ''
---

{
  kind === 'tourengenie' && (
    <svg class="link-icon" viewBox="0 0 64 64" aria-hidden="true">
      <g fill="currentColor" opacity="0.45">
        <circle cx="14" cy="32" r="3.5" />
        <circle cx="14" cy="50" r="3.5" />
        <circle cx="32" cy="14" r="3.5" />
        <circle cx="32" cy="50" r="3.5" />
        <circle cx="50" cy="14" r="3.5" />
      </g>
      <path d="M14 14 L32 32 H50 V50" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="14" cy="14" r="6" fill="currentColor" />
      <circle cx="32" cy="32" r="5.5" fill="var(--color-bg)" stroke="currentColor" stroke-width="4" />
      <circle cx="50" cy="32" r="5.5" fill="var(--color-bg)" stroke="currentColor" stroke-width="4" />
      <circle cx="50" cy="50" r="6.5" fill="currentColor" />
    </svg>
  )
}
{
  kind === 'github' && (
    <svg class="link-icon" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
    </svg>
  )
}
{
  kind === 'pdf' && (
    <svg class="link-icon" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round">
      <path d="M3.5 1.5h6l3 3v10h-9z" />
      <path d="M9.5 1.5v3h3M5.5 8.5h5M5.5 11h5" />
    </svg>
  )
}
