---
import heat from '@/assets/geo/heat-illustrative.json'
import Figure from '@/components/Figure.astro'
import Layout from '@/layouts/Layout.astro'
import type { Lang } from '@/i18n'
import { UI, pagePath, projectPath } from '@/i18n'
import { getCases, getPage, getSmallProjects } from '@/lib/content'
import { parsePageIntro } from '@/lib/prose'
import { headingNbsp, illustrativeNote } from '@/lib/text'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const ui = UI[lang]
const page = await getPage(lang, 'projects')
const intro = parsePageIntro(page.body ?? '')
const cases = await getCases(lang)
const small = await getSmallProjects(lang)
const note = illustrativeNote(heat, lang)
---

<Layout
  lang={lang}
  path={pagePath(lang, 'projects')}
  title={page.data.title}
  description={page.data.description}
  current="projects"
  alternate={pagePath(lang === 'de' ? 'en' : 'de', 'projects')}
>
  <div class="wrap page-top">
    <h1>{headingNbsp(intro.title)}</h1>
    <p class="intro">{intro.intro}</p>
    <div class="cards" style="margin-top:40px">
      {cases.map((project) => {
        const status = project.data.status ? ui.statusValue[project.data.status] : ''
        const line = project.data.year && status ? headingNbsp(`${project.data.year} · ${status}`) : ''
        return (
          <a class="card" href={projectPath(lang, project.data.slug)}>
            <Figure file={`${project.data.slug}/cover`} lang={lang} instance="card" decorative bare />
            {project.data.slug === 'berlin-lst-downscaling' && note && <span class="note">{note}</span>}
            <h2>{headingNbsp(project.data.title)}</h2>
            <p class="sum">{project.data.description}</p>
            {line && <span class="st">{line}</span>}
          </a>
        )
      })}
    </div>
    <div class="further">
      <h2>{headingNbsp(intro.furtherTitle)}</h2>
      {small.map((item) => (
        <div class="row-small">
          <b>{item.data.title}</b>
          <span class="mono">{item.data.year}</span>
          <p>{item.data.description}</p>
          {item.data.links[0] && (
            <a class="tl tl-acc" href={item.data.links[0].href} target="_blank" rel="noopener noreferrer">{item.data.links[0].label}</a>
          )}
        </div>
      ))}
    </div>
  </div>
</Layout>
