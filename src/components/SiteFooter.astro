---
import type { Lang } from '@/i18n'
import { UI, pagePath } from '@/i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const ui = UI[lang]
---

<footer class="foot">
  <div class="wrap">
    <div class="foot-row">
      <span>{ui.footer}</span>
      <nav aria-label={ui.legalLabel}>
        <a class="tl" href={pagePath(lang, 'imprint')}>{ui.imprint}</a>
        <a class="tl" href={pagePath(lang, 'privacy')}>{ui.privacy}</a>
      </nav>
    </div>
  </div>
</footer>
