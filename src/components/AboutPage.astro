---
import PersonSchema from '@/components/PersonSchema.astro'
import Layout from '@/layouts/Layout.astro'
import type { Lang } from '@/i18n'
import { pagePath } from '@/i18n'
import { getPage } from '@/lib/content'
import { parseAbout } from '@/lib/prose'
import { escapeHtml, headingNbsp, inlineHtml } from '@/lib/text'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const page = await getPage(lang, 'about')
const about = parseAbout(page.body ?? '')

function itemHtml(title: string, line: string) {
  if (title) {
    const rest = line ? ` · ${inlineHtml(line)}` : ''
    return `<strong>${escapeHtml(title)}</strong>${rest}`
  }
  return inlineHtml(line)
}
---

<Layout
  lang={lang}
  path={pagePath(lang, 'about')}
  title={page.data.title}
  description={page.data.description}
  current="about"
  alternate={pagePath(lang === 'de' ? 'en' : 'de', 'about')}
>
  <div class="wrap page-top">
    <h1>{headingNbsp(about.title)}</h1>
    <p class="intro about-intro">{about.intro}</p>
    {about.sections.map((section) => (
      <section class="about-sec">
        <h2>{headingNbsp(section.heading)}</h2>
        <ul class="about-list">
          {section.items.map((item) => (
            <li class="about-row">
              <span class="about-period">{item.period}</span>
              <div class="about-copy">
                <p set:html={itemHtml(item.title, item.line)} />
                {item.details.map((detail) => <p class="muted" set:html={inlineHtml(detail)} />)}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
    {about.more && (
      <p class="about-more"><a class="tl tl-strong" href={about.more.href}>{about.more.label}</a></p>
    )}
  </div>
  <PersonSchema slot="jsonld" lang={lang} />
</Layout>
