---
import { NAV_LINKS } from '@/consts'
import { withBasePath } from '@/lib/paths'

const path = Astro.url.pathname.replace(/\/$/, '') || '/'

function isCurrent(href: string) {
  if (href === '/') return path === '/'
  return path === href || path.startsWith(`${href}/`)
}
---

<header class="nav">
  <a class="skip" href="#main">Skip to content</a>
  <div class="wrap nav-bar">
    <a class="wordmark" href={withBasePath('/')}>Silas Pignotti</a>
    <nav class="nav-links" aria-label="Primary">
      {
        NAV_LINKS.map((link) => (
          <a
            class="nav-link"
            href={withBasePath(link.href)}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="nav-actions">
      <button
        type="button"
        class="nav-toggle"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="site-nav-panel"
      >
        <span class="nav-toggle-open">Menu</span>
        <span class="nav-toggle-close">Close</span>
      </button>
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch color theme">
        <span class="when-light">Light</span>
        <span class="when-dark">Dark</span>
      </button>
    </div>
  </div>
  <div class="wrap nav-panel" id="site-nav-panel" hidden>
    <nav aria-label="Primary">
      {
        NAV_LINKS.map((link) => (
          <a
            class="nav-link"
            href={withBasePath(link.href)}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement
  const toggle = document.querySelector('[data-theme-toggle]')
  const menuButton = document.querySelector('[data-nav-toggle]')
  const panel = document.getElementById('site-nav-panel')

  function themeLabel() {
    if (!(toggle instanceof HTMLButtonElement)) return
    const dark = root.getAttribute('data-theme') === 'dark'
    toggle.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme')
  }

  themeLabel()

  toggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
    root.setAttribute('data-theme', next)
    root.style.colorScheme = next
    try {
      localStorage.setItem('theme', next)
    } catch {
      /* storage can be blocked */
    }
    themeLabel()
  })

  menuButton?.addEventListener('click', () => {
    if (!(menuButton instanceof HTMLButtonElement) || !panel) return
    const open = menuButton.getAttribute('aria-expanded') === 'true'
    menuButton.setAttribute('aria-expanded', String(!open))
    panel.hidden = open
  })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !(menuButton instanceof HTMLButtonElement) || !panel) return
    if (menuButton.getAttribute('aria-expanded') !== 'true') return
    menuButton.setAttribute('aria-expanded', 'false')
    panel.hidden = true
    menuButton.focus()
  })
</script>
