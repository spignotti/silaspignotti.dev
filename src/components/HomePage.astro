---
import CaseBand from '@/components/CaseBand.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import PersonSchema from '@/components/PersonSchema.astro'
import Layout from '@/layouts/Layout.astro'
import type { Lang } from '@/i18n'
import { SECTION_IDS, UI, pagePath } from '@/i18n'
import { getAreas, getCases, getPage, getSmallProjects } from '@/lib/content'
import { parseHome } from '@/lib/prose'
import { headingNbsp, inlineHtml, pruneDeadCaseLinks } from '@/lib/text'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const ui = UI[lang]
const ids = SECTION_IDS[lang]
const page = await getPage(lang, 'home')
const home = parseHome(page.body ?? '')
const areas = await getAreas(lang)
const cases = await getCases(lang)
const caseSlugs = cases.map((item) => item.data.slug)
const small = await getSmallProjects(lang)
const lead = cases[0]
const rest = cases.slice(1)
---

<Layout
  lang={lang}
  path={pagePath(lang, 'home')}
  title={page.data.title}
  description={page.data.description}
  current="home"
  alternate={pagePath(lang === 'de' ? 'en' : 'de', 'home')}
  mainClass="has-hero"
  motion
>
  <section class="hero" data-hero>
    <div class="hero-pin">
      <canvas class="hero-canvas" aria-hidden="true"></canvas>
      <div class="hero-copy">
        <h1 class="hero-name">{headingNbsp(home.name)}</h1>
        <p class="hero-lead">{headingNbsp(home.fieldLine)}</p>
        <div class="hero-actions">
          <a class="btn" href={`#${ids.projects}`}>{ui.viewProjects}</a>
          <span class="links">
            {home.contactLinks.map((link) => (
              <a class="tl" href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                {link.label}
              </a>
            ))}
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section split" id={ids.profile} aria-labelledby={`h-${ids.profile}`}>
    <h2 class="h2" id={`h-${ids.profile}`}>{headingNbsp(home.profileTitle)}</h2>
    <div class="split-body">
      {home.profile.map((paragraph) => <p class="lead-text">{paragraph}</p>)}
    </div>
  </section>

  <section class="wrap section" id={ids.areas} aria-labelledby={`h-${ids.areas}`}>
    <div class="section-head"><h2 class="h2" id={`h-${ids.areas}`}>{headingNbsp(home.areasTitle)}</h2></div>
    <div class="fields">
      {areas.map((area) => {
        const proof = pruneDeadCaseLinks(area.data.proof, caseSlugs, lang)
        return (
          <div class="field">
            <h3>{headingNbsp(area.data.title)}</h3>
            <p>{area.data.summary}</p>
            <dl>
              <div><dt>{ui.tools}</dt><dd>{area.data.tools}</dd></div>
              {proof && (
                <div><dt>{ui.proof}</dt><dd set:html={inlineHtml(proof, 'tl tl-acc')} /></div>
              )}
            </dl>
          </div>
        )
      })}
    </div>
  </section>

  <section id={ids.projects} aria-labelledby={`h-${ids.projects}`}>
    <div class="wrap section" style="padding-bottom:40px">
      <div class="section-head" style="margin-bottom:0">
        <h2 class="h2" id={`h-${ids.projects}`}>{headingNbsp(home.projectsTitle)}</h2>
        <p class="intro">{home.projectsIntro}</p>
      </div>
    </div>

    {lead && <CaseBand project={lead} lang={lang} />}

    <div class="wrap">
      {rest.length > 0 && (
        <div class="cards cards--home">
          {rest.map((project) => <ProjectCard project={project} lang={lang} as="h3" />)}
        </div>
      )}
      {small.length > 0 && (
        <div class="rows--home">
          {small.map((item) => (
            <div class="row-small">
              <b>{item.data.title}</b>
              <span class="mono">{item.data.year}</span>
              <p>{item.data.description}</p>
              {item.data.links[0] && (
                <a class="tl tl-acc" href={item.data.links[0].href} target="_blank" rel="noopener noreferrer">{item.data.links[0].label}</a>
              )}
            </div>
          ))}
        </div>
      )}
      <div class="all-link"><a class="tl tl-strong" href={pagePath(lang, 'projects')}>{ui.allProjects}</a></div>
    </div>
  </section>

  <section class="wrap section split" id={ids.about} aria-labelledby={`h-${ids.about}`}>
    <h2 class="h2" id={`h-${ids.about}`}>{headingNbsp(home.aboutTitle)}</h2>
    <div class="split-body">
      {home.about.map((paragraph) => <p set:html={inlineHtml(paragraph)} />)}
      {home.aboutLink && (
        <p class="more-link">
          <a
            class="tl tl-strong"
            href={home.aboutLink.href}
            target={home.aboutLink.href.startsWith('http') ? '_blank' : undefined}
            rel={home.aboutLink.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          >
            {home.aboutLink.label}
          </a>
        </p>
      )}
    </div>
  </section>

  <section class="wrap section" id={ids.contact} aria-labelledby={`h-${ids.contact}`}>
    <h2 class="h2" id={`h-${ids.contact}`}>{headingNbsp(home.contactTitle)}</h2>
    <p class="intro contact-lead">{home.contactLead}</p>
    <p class="contact-links">
      {home.contactLinks.map((link) => (
        <a class="tl" href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
          {link.label}
        </a>
      ))}
    </p>
  </section>
  <PersonSchema slot="jsonld" lang={lang} />
</Layout>
