---
import type { Lang } from '@/i18n'
import Figure from './Figure.astro'

interface Props {
  lang: Lang
  label: string
  describedBy?: string
}

const { lang, label, describedBy } = Astro.props
---

<div class="cmp-slot">
  <div class="cmp-fallback fig-art">
    <Figure file="berlin-lst-downscaling/resolution-compare" lang={lang} instance="fallback" bare />
  </div>
  <div class="cmp" hidden style="--x: 85%">
    <canvas aria-hidden="true"></canvas>
    <canvas aria-hidden="true"></canvas>
    <span class="chip l">100 m</span>
    <span class="chip r">10 m</span>
    <div
      class="handle"
      role="slider"
      tabindex="0"
      aria-label={label}
      aria-describedby={describedBy}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="85"
    >
      <span class="grip">
        <svg viewBox="0 0 14 14" aria-hidden="true">
          <path
            d="M5 3 1.5 7 5 11M9 3l3.5 4L9 11"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </div>
</div>
