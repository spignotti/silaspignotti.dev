---
import { SITE } from '@/consts'
import { withBasePath } from '@/lib/paths'
import Favicons from './Favicons.astro'
import PostHog from './PostHog.astro'
---

<head>
  <script is:inline>
    ;(function () {
      var key = 'theme'
      var root = document.documentElement
      function systemDark() {
        return window.matchMedia('(prefers-color-scheme: dark)').matches
      }
      function apply(theme) {
        root.setAttribute('data-theme', theme)
        root.style.colorScheme = theme
      }
      try {
        var stored = localStorage.getItem(key)
        if (stored === 'dark' || stored === 'light') {
          apply(stored)
        } else {
          apply(systemDark() ? 'dark' : 'light')
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (event) {
            if (!localStorage.getItem(key)) apply(event.matches ? 'dark' : 'light')
          })
        }
      } catch (error) {
        apply(systemDark() ? 'dark' : 'light')
      }
    })()
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="author" content={SITE.author} />
  <meta name="theme-color" content="#F7F7F5" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0B0C0F" media="(prefers-color-scheme: dark)" />
  <link rel="preload" href={withBasePath('/fonts/Geist-Regular.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={withBasePath('/fonts/Geist-SemiBold.woff2')} as="font" type="font/woff2" crossorigin />
  <Favicons />
  <slot />
  <PostHog />
</head>
