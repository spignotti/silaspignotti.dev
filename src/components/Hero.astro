---
import type { CollectionEntry } from 'astro:content'
import type { Lang } from '@/i18n'
import { SOCIAL_LINKS } from '@/consts'
import Copy from './Copy.astro'
import Figure from './Figure.astro'

interface Props {
  hero: NonNullable<CollectionEntry<'pages'>['data']['hero']>
  lang: Lang
}
const { hero, lang } = Astro.props
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-text">
    <p class="label">{hero.eyebrow}</p>
    <h1 id="hero-heading" class="display hero-heading"><Copy text={hero.heading} /></h1>
    <p class="lead"><Copy text={hero.lead} /></p>
    <p class="hero-facts"><Copy text={hero.facts} /></p>
    <div class="hero-actions">
      <a class="button button-primary" href="#case-studies">{hero.primaryAction}</a>
      <ul class="inline-links">
        {
          SOCIAL_LINKS.map((link) => (
            <li>
              <a
                class="text-link"
                href={link.href}
                {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {link.icon === 'email' ? (lang === 'de' ? 'E-Mail' : 'Email') : link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="hero-art reveal">
    <Figure name="site/hero-route" lang={lang} instance="hero" />
  </div>
</section>
