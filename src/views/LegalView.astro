---
import { render } from 'astro:content'
import Placeholder from '@/components/Placeholder.astro'
import Layout from '@/layouts/Layout.astro'
import { getPage } from '@/lib/data-utils'

interface Props {
  page: 'imprint' | 'privacy'
}
const entry = await getPage('de', Astro.props.page)
const { Content } = await render(entry)
---

<Layout lang="de" title={entry.data.title} description={entry.data.description} contact={false}>
  <header class="measure">
    <h1 class="h1">{entry.data.title}</h1>
  </header>
  <div class="prose block">
    <Content components={{ Placeholder }} />
  </div>
</Layout>
