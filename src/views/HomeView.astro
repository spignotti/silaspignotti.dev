---
import AreaGrid from '@/components/AreaGrid.astro'
import CaseCard from '@/components/CaseCard.astro'
import Hero from '@/components/Hero.astro'
import PersonSchema from '@/components/PersonSchema.astro'
import Layout from '@/layouts/Layout.astro'
import type { Lang } from '@/i18n'
import { UI, otherLang, pagePath } from '@/i18n'
import { getAreas, getPage, getProjects } from '@/lib/data-utils'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const ui = UI[lang]
const page = await getPage(lang, 'home')
const cases = await getProjects(lang, 'case-study')
const all = await getProjects(lang)
const areas = await getAreas(lang)
if (!page.data.hero) throw new Error(`pages/${lang}/home needs a hero`)
---

<Layout lang={lang} title={page.data.title} description={page.data.description} alternate={pagePath(otherLang(lang), 'home')}>
  <PersonSchema slot="head" lang={lang} />

  <Hero hero={page.data.hero} lang={lang} />

  <section id="case-studies" class="section reveal" aria-labelledby="cases-heading">
    <h2 id="cases-heading" class="h2">{ui.caseStudies}</h2>
    <div class="case-grid">
      {cases.map((project) => <CaseCard project={project} lang={lang} />)}
    </div>
  </section>

  <section class="section reveal" aria-labelledby="areas-heading">
    <h2 id="areas-heading" class="h2">{ui.areas}</h2>
    <AreaGrid areas={areas} projects={all} lang={lang} />
  </section>
</Layout>
