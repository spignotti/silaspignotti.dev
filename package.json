{
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "astro",
    "website"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/spignotti/silaspignotti.dev.git"
  },
  "bugs": {
    "url": "https://github.com/spignotti/silaspignotti.dev/issues"
  },
  "homepage": "https://silaspignotti.dev",
  "name": "silaspignotti.dev",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "process:project-media": "tsx scripts/process-project-media.ts",
    "verify:node": "node scripts/ensure-node-version.mjs",
    "dev": "astro dev --port 3010",
    "start": "astro preview",
    "build": "pnpm verify:node && astro build",
    "check": "pnpm verify:node && astro check",
    "preview": "astro preview",
    "astro": "astro",
    "prettier": "prettier --write **/*.{ts,tsx,css,astro} --ignore-path .gitignore"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "^6.3.5",
    "@astrojs/mdx": "^4.3.3",
    "@expressive-code/plugin-collapsible-sections": "^0.41.3",
    "@expressive-code/plugin-line-numbers": "^0.41.3",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^5.12.9",
    "astro-expressive-code": "^0.41.3",
    "gray-matter": "^4.0.3",
    "rehype-external-links": "^3.0.0",
    "rehype-pretty-code": "^0.14.1",
    "remark-emoji": "^5.0.1",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss",
      "prettier-plugin-astro-organize-imports"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
